# Resend (https://resend.com) — required to send "Book a demo" form emails.
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives booking requests. Defaults to ynguetse@gmail.com if unset.
CONTACT_EMAIL_TO=

# Sender address for outgoing emails. Must be either:
#   - "onboarding@resend.dev" (Resend's shared sandbox sender — works with no setup, low deliverability), or
#   - an address on a domain you've verified in Resend (e.g. "Callora <booking@callora.agency>")
# Defaults to "Callora <onboarding@resend.dev>" if unset.
CONTACT_EMAIL_FROM=

# Production URL used for metadata, sitemap.xml, robots.txt, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://callora.agency


# Live "Try Ora" test call buttons on the landing page. "true" enables them;
# any other value (or unset) shows them disabled. Inlined at build time — redeploy after changing.
NEXT_PUBLIC_TEST_CALL_ENABLED=false

# Callora API (app.callora/apps/api) — the Callora Msg waitlist is stored there.
# CALLORA_API_URL is the API base URL; WAITLIST_API_KEY must match WAITLIST_API_KEY in the API .env.
CALLORA_API_URL=http://localhost:8000
WAITLIST_API_KEY=
