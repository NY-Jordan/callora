# Resend (https://resend.com) — required to send "Book a demo" form emails.
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives booking requests. Defaults to ynguetse@gmail.com if unset.
CONTACT_EMAIL_TO=

# Sender address for outgoing emails. Must be either:
#   - "onboarding@resend.dev" (Resend's shared sandbox sender — works with no setup, low deliverability), or
#   - an address on a domain you've verified in Resend (e.g. "Callora <booking@callora.ai>")
# Defaults to "Callora <onboarding@resend.dev>" if unset.
CONTACT_EMAIL_FROM=

# Production URL used for metadata, sitemap.xml, robots.txt, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://callora.ai

# Telnyx AI Assistant id of the public "Ora" demo receptionist (clinic "Callora — Démo" in
# app.callora), used by the "Test Ora live" browser call feature. Not a secret — it's embedded
# in client-side WebRTC calls the same way it is in the app.callora dashboard. See
# app.callora's apps/api/app/Services/ClinicProvisioner.php for how that demo clinic is created.
NEXT_PUBLIC_TELNYX_DEMO_ASSISTANT_ID=
